# Copy this file:
#   backend/.env  -> copy from backend/.env.example
#   frontend/.env -> copy from frontend/.env.example
#
# This root file is just a reminder of what the project needs.

# --- Backend ---
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Local PostgreSQL (used starting in Phase 2)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/devapi

# JWT secrets (used starting in Phase 3)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# --- Frontend ---
VITE_GRAPHQL_URL=http://localhost:4000/graphql
