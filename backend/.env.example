# Copy this file to .env in this same folder:
#   copy .env.example .env
#   (Windows PowerShell: Copy-Item .env.example .env)

# Server
PORT=4000
NODE_ENV=development

# Frontend origin (used for CORS)
FRONTEND_URL=http://localhost:3000

# Local PostgreSQL (Phase 2)
# Replace USER and PASSWORD with your local Postgres login, then:
#   CREATE DATABASE devapi;
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/devapi

# JWT secrets — used in Phase 3 (authentication)
# Change these before you ever deploy
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
